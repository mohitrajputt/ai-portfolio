# ── AI Portfolio Assistant: server-side secrets ─────────────────────────────
# All values are read at runtime by the serverless function (api/chat.ts).
#
# NEVER prefix these with VITE_ (that would expose them to the browser).
# NEVER commit the real values.
#
# Local development:
#   - copy this file to .env and fill in your real GROQ_API_KEY
#
# Production (Vercel):
#   - the real values go in the Vercel dashboard only
#     (Project -> Settings -> Environment Variables -> Encrypted)
#   - Vercel does NOT read your local .env during deploy

# Required
GROQ_API_KEY=

# Optional (shown are the defaults)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Optional rate limiting (requests per IP per window)
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=3600000